+#ifdef DUMP_ACPI_TABLES
+        /* offline ACPI dump: force every MADT CPU entry enabled so the dumped
+         * APIC table matches a fully-populated live TD (only 1 vCPU is actually
+         * instantiated under the dump, see x86_cpus_init). */
+        pc_madt_cpu_entry(i, apic_ids, table_data, true);
+#else
         pc_madt_cpu_entry(i, apic_ids, table_data, false);
+#endif
         if (apic_ids->cpus[i].arch_id > 254) {
             x2apic_mode = true;
         }
